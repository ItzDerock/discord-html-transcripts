{
  "name": "discord-html-transcripts",
  "version": "3.2.0",
  "description": "A nicely formatted html transcript generator for discord.js.",
  "main": "dist/index.js",
  "homepage": "https://github.com/ItzDerock/discord-html-transcripts",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "test": "tsx ./tests/generate.ts",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItzDerock/discord-html-transcripts.git"
  },
  "keywords": [
    "discord.js",
    "discord.js-transcripts",
    "discord.js-html-transcripts",
    "html-transcripts",
    "discord-html-transcripts",
    "discord-transcripts"
  ],
  "author": "Derock <derock@derock.dev>",
  "license": "GPL-3.0-or-later",
  "files": ["dist/**/*.js", "dist/**/*.d.ts", "dist/**/*.js.map"],
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/debug": "^4.1.12",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "debug": "^4.4.1",
    "discord.js": "^14.20.0",
    "dotenv": "^16.5.0",
    "sharp": "^0.34.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@derockdev/discord-components-core": "^3.6.1",
    "@derockdev/discord-components-react": "^3.6.1",
    "discord-markdown-parser": "~1.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "simple-markdown": "^0.7.3",
    "twemoji": "^14.0.2"
  },
  "peerDependencies": {
    "discord.js": "^14.0.0 || ^15.0.0"
  },
  "overrides": {
    "react": "$react"
  },
  "packageManager": "pnpm@10.12.1"
}
